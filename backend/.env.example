# Copy to .env and fill in. Get these from https://discord.com/developers/applications → your app → OAuth2.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Where people open the website. Add <PUBLIC_URL>/api/auth/discord/callback as a Redirect in the Discord app.
PUBLIC_URL=http://localhost:5173
# Discord user ids (comma-separated) that may delete / exclude any match, not just their own uploads
ADMIN_DISCORD_IDS=
